<?xml version="1.0" encoding="utf-8"?>
<!-- Debug (testnet) build only: let the Apps tab load a dApp served over plain
     http on this device's loopback (`adb reverse tcp:3000 tcp:3000`) for local
     testing. Everything else stays https-only, as in release. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
